.boutique-hero{position:relative;width:100%;height:840rpx;text-align:left}.boutique-hero image{height:100%}.boutique-hero-label{position:absolute;bottom:0;left:0;right:0;padding:60rpx 36rpx 26rpx;color:white;font-size:21rpx;letter-spacing:2rpx;background:linear-gradient(transparent,rgba(33,26,19,.6))}.boutique-story{background:#342c25;color:#f2ece2}.boutique-story .eyebrow{color:#c5b297}.boutique-story .section-title{font-size:48rpx;margin:24rpx 0}.boutique-story .body-text{color:#d3c6b4}.boutique-paragraph{margin-top:26rpx}.boutique-story .outline-button{border-color:#a28f79;margin-top:32rpx;color:#f2ece2}.store-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:28rpx 20rpx}.store-photo{min-width:0;text-align:left}.store-photo image{height:380rpx}.website-button{margin-top:30rpx}
