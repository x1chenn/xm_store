.product-page{padding-bottom:180rpx}.product-gallery{position:relative}.product-gallery swiper{height:860rpx;display:block}.product-gallery swiper-item,.product-gallery image{height:100%}.gallery-label{position:absolute;bottom:0;left:0;right:0;color:white;padding:55rpx 36rpx 23rpx;font-size:20rpx;background:linear-gradient(transparent,rgba(32,24,19,.55));pointer-events:none}.product-info .eyebrow{font-size:18rpx;letter-spacing:2rpx}.product-info .section-title{font-size:44rpx;margin:20rpx 0}.detail-variants{display:flex;flex-wrap:wrap;gap:16rpx;margin:34rpx 0}.variant{display:flex;align-items:center;gap:12rpx;border:1rpx solid #d9d0c4;padding:16rpx 23rpx;font-size:24rpx}.variant-selected{border-color:#302923}.specs{border-top:1rpx solid #ded9d1;margin:30rpx 0}.spec-row{display:flex;gap:30rpx;padding:22rpx 0;border-bottom:1rpx solid #ded9d1;font-size:26rpx}.spec-label{width:100rpx;color:#8c7f6e;flex-shrink:0}.product-info .text-button{margin-top:30rpx}.detail-actions{position:fixed;bottom:0;left:0;right:0;display:grid;grid-template-columns:1fr 1.4fr;gap:18rpx;padding:22rpx 28rpx;padding-bottom:calc(22rpx + env(safe-area-inset-bottom));background:#faf9f6;border-top:1rpx solid #ded9d1;z-index:3}.detail-actions .solid-button{padding-left:24rpx;padding-right:24rpx}.missing .solid-button{margin-top:30rpx}
