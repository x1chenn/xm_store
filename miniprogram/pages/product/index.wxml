<view wx:if="{{missing}}" class="section missing"><view class="section-title">这件服饰暂未收录</view><view class="body-text">到衣橱看看其他款式吧。</view><button class="solid-button" bindtap="openCollection">浏览衣橱 <text>↗</text></button></view>
<view wx:else class="page product-page"><view class="product-gallery"><swiper current="{{photoIndex}}" bindchange="changePhoto" circular="{{images.length > 1}}" indicator-dots="{{images.length > 1}}" indicator-color="rgba(255,255,255,.4)" indicator-active-color="#faf9f6"><swiper-item wx:for="{{images}}" wx:key="*this"><image src="{{item}}" mode="aspectFill" bindtap="previewImage"/></swiper-item></swiper><view class="gallery-label">{{photoIndex + 1}} / {{images.length}} · 点击看大图</view></view><view class="section product-info"><view class="eyebrow">XM COLLECTION / {{product.english}}</view><view class="section-title">{{product.name}}</view><view class="body-text">{{product.description}}</view><view class="detail-variants"><button wx:for="{{variants}}" wx:key="color" class="variant {{variantIndex === index ? 'variant-selected' : ''}}" data-index="{{index}}" bindtap="changeVariant"><text class="color-dot" style="background:{{item.hex}};"></text>{{item.color}}</button></view><view class="specs"><view class="spec-row"><text class="spec-label">颜色</text><text>{{color}}</text></view><view class="spec-row"><text class="spec-label">材质</text><text>{{product.materialText}}</text></view><view class="spec-row"><text class="spec-label">价格</text><text>{{product.priceText}}</text></view><view class="spec-row"><text class="spec-label">尺码</text><text>{{product.sizesText}}</text></view></view><view class="muted-note">颜色、尺码与价格信息，以店内实物为准。</view><button class="text-button" bindtap="openBoutique">到店感受，找到喜欢 <text>↗</text></button></view><view class="detail-actions"><button class="outline-button" bindtap="openCollection">浏览衣橱</button><button class="solid-button" open-type="share">分享这件服饰 <text>↗</text></button></view></view>
