page{background:#faf9f6;color:#302923;font-family:Arial,"PingFang SC","Microsoft YaHei",sans-serif;font-size:28rpx;line-height:1.7}
view,text,image,button,scroll-view,swiper,swiper-item{box-sizing:border-box}
image{display:block;width:100%}button{font:inherit;border-radius:0;margin:0;padding:0;background:none;color:inherit;line-height:inherit}button::after{border:0}
.page{padding-bottom:40rpx}.brand{display:flex;align-items:center;justify-content:space-between;padding:26rpx 40rpx;border-bottom:1rpx solid #ded9d1;background:#faf9f6}.brand-mark{font-family:Georgia,"Times New Roman",serif;font-size:65rpx;line-height:1;letter-spacing:-4rpx}.brand-label{font-size:22rpx;letter-spacing:6rpx;margin-left:25rpx;padding-left:25rpx;border-left:1rpx solid #b8afa4}.brand-message{font-size:20rpx;color:#887b6b;letter-spacing:2rpx}.brand-left{display:flex;align-items:center}
.eyebrow{font-size:19rpx;letter-spacing:3rpx;color:#827565;line-height:1.8}.section{padding:48rpx 36rpx}.section-title{font-family:Georgia,"Songti SC",SimSun,serif;font-size:44rpx;font-weight:400;letter-spacing:2rpx;line-height:1.5;margin:14rpx 0}.section-english{font-family:Georgia,"Times New Roman",serif;font-style:italic;font-size:30rpx;color:#978878}.body-text{font-size:26rpx;line-height:1.95;color:#756d63}.solid-button{display:flex;align-items:center;justify-content:space-between;padding:24rpx 30rpx;background:#302923;color:#fff;font-size:26rpx;letter-spacing:1rpx}.outline-button{display:flex;align-items:center;justify-content:center;padding:22rpx 26rpx;border:1rpx solid #b8aea0;font-size:26rpx}.arrow{font-size:36rpx;line-height:1}.text-button{display:inline-flex;gap:30rpx;align-items:center;border-bottom:1rpx solid #928574;padding:10rpx 0;font-size:25rpx}.section-head{display:flex;align-items:flex-end;justify-content:space-between;gap:25rpx;margin-bottom:28rpx}.piece-count{font-size:22rpx;color:#877b6e}.product-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:36rpx 20rpx}.product-card{min-width:0;text-align:left}.product-cover{position:relative;height:430rpx;background:#e6e0d6;overflow:hidden}.product-cover image{height:100%}.product-category{position:absolute;top:16rpx;left:16rpx;background:rgba(250,249,246,.93);font-size:20rpx;padding:5rpx 12rpx}.product-name{font-size:25rpx;margin-top:18rpx;line-height:1.6}.product-tags{font-size:21rpx;color:#8c8071;margin-top:5rpx}.product-meta{font-size:21rpx;color:#776c5e;border-top:1rpx solid #ded9d1;margin-top:16rpx;padding-top:12rpx}.card-colors{display:flex;gap:12rpx;margin-top:12rpx}.color-dot{display:inline-block;width:18rpx;height:18rpx;border:1rpx solid #c3b8a8}.soft-section{background:#eee9e1}.muted-note{font-size:22rpx;color:#8a7d6e;line-height:1.9}.bottom-space{height:30rpx}.photo-counter{font-size:22rpx;color:#8b7e6c}.photo-caption{font-size:22rpx;color:#857a6d;line-height:1.9;margin-top:16rpx}
